{
  "name": "workkit",
  "displayName": "WorkKit",
  "description": "Run workspace files, execute VS Code commands, and open saved Copilot Chat prompts from a compact panel.",
  "version": "0.1.0",
  "publisher": "chengbin",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "workspace",
    "scripts",
    "terminal",
    "powershell",
    "commands",
    "prompts",
    "productivity",
    "copilot chat",
    "workspace scripts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sengbin/WorkKit.git"
  },
  "bugs": {
    "url": "https://github.com/sengbin/WorkKit/issues"
  },
  "homepage": "https://github.com/sengbin/WorkKit#readme",
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "workKit.addWorkspaceFile",
        "title": "添加到工具箱运行项"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "workKit.addWorkspaceFile",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "workKit.addWorkspaceFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "7_modification"
        }
      ]
    },
    "icons": {
      "workkit-logo": {
        "description": "工具箱状态栏图标",
        "default": {
          "fontPath": "./resources/workkit-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "workKitPanel",
          "title": "工具箱",
          "icon": "resources/logo.svg"
        }
      ]
    },
    "views": {
      "workKitPanel": [
        {
          "type": "webview",
          "id": "workKit.shortcutView",
          "name": "工具箱",
          "icon": "resources/logo.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
