{
  "name": "vscode-tools",
  "displayName": "开发者工具箱",
  "description": "从状态栏快速运行工作区 PowerShell 脚本和 VS Code 命令。",
  "version": "0.1.0",
  "publisher": "sengbin",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "powershell",
    "commands",
    "productivity",
    "status bar",
    "script"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sengbin/vscode-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sengbin/vscode-tools/issues"
  },
  "homepage": "https://github.com/sengbin/vscode-tools#readme",
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscodeTools.openMenu",
        "title": "打开工具菜单",
        "category": "开发者工具箱"
      },
      {
        "command": "vscodeTools.manageItems",
        "title": "管理自定义工具",
        "category": "开发者工具箱"
      }
    ],
    "icons": {
      "vscode-tools-logo": {
        "description": "开发者工具箱状态栏图标",
        "default": {
          "fontPath": "./resources/vscode-tools-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "vscodeToolsPanel",
          "title": "开发者工具箱",
          "icon": "resources/logo.svg"
        }
      ]
    },
    "views": {
      "vscodeToolsPanel": [
        {
          "type": "webview",
          "id": "vscodeTools.menuView",
          "name": "工具菜单",
          "icon": "resources/logo.svg"
        }
      ]
    }
  },
  "scripts": {
    "generate:icons": "node tools/generate-statusbar-icon.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run generate:icons && npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "fantasticon": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
