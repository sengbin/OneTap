{
  "name": "vscode-tools",
  "displayName": "VS Code 工具箱",
  "description": "在底部工具箱管理工作区文件、VS Code 命令和 Copilot 消息。",
  "version": "0.1.0",
  "publisher": "sengbin",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "powershell",
    "commands",
    "productivity",
    "copilot chat",
    "workspace scripts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sengbin/vscode-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sengbin/vscode-tools/issues"
  },
  "homepage": "https://github.com/sengbin/vscode-tools#readme",
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscodeTools.addWorkspaceFile",
        "title": "添加到工具箱运行项"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vscodeTools.addWorkspaceFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "7_modification"
        }
      ]
    },
    "icons": {
      "vscode-tools-logo": {
        "description": "工具箱状态栏图标",
        "default": {
          "fontPath": "./resources/vscode-tools-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "vscodeToolsPanel",
          "title": "工具箱",
          "icon": "resources/logo.svg"
        }
      ]
    },
    "views": {
      "vscodeToolsPanel": [
        {
          "type": "webview",
          "id": "vscodeTools.menuView",
          "name": "工具箱",
          "icon": "resources/logo.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
