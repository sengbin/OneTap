{
  "name": "vscode-tools",
  "displayName": "开发者工具箱",
  "description": "从状态栏快速运行工作区 PowerShell 脚本和 VS Code 命令。",
  "version": "0.1.0",
  "publisher": "sengbin",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "powershell",
    "commands",
    "productivity",
    "status bar",
    "script"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sengbin/vscode-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sengbin/vscode-tools/issues"
  },
  "homepage": "https://github.com/sengbin/vscode-tools#readme",
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vscodeTools.openMenu",
    "onCommand:vscodeTools.manageItems"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscodeTools.openMenu",
        "title": "打开工具菜单",
        "category": "开发者工具箱"
      },
      {
        "command": "vscodeTools.manageItems",
        "title": "管理自定义工具",
        "category": "开发者工具箱"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  }
}